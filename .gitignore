# Ignore everything
*

# Allow .gitignore itself
!.gitignore

# Track only these three
!README.md
!server/
!server/**
!B1_Platform/
!B1_Platform/**
!docs/
!docs/**

# Allow deploy artifacts (root-level, otherwise swallowed by the leading *)
!docker-compose.yml
!docker-compose.prod.yml
!.env.example
!Material/
!Material/**

# 本地交付物，不入库
docs/截图/
docs/立项材料/
docs/软著/

# Exclude build outputs
server/target/**
server/target/
server/BOOT-INF/**
server/BOOT-INF/

# Exclude secrets (local-only config, never commit)
server/src/main/resources/application-local.yml

# Exclude runtime logs and build artifacts
server/*.log
server/**/*.log
B1_Platform/dev.log
B1_Platform/test-dev.log
B1_Platform/dist/
B1_Platform/dist.zip
B1_Platform/.env*.local

# Exclude real secrets (only the .env.example template is tracked)
.env

